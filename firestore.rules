rules_version = '2';

// Règles de sécurité du Carnet des cadeaux.
// À coller dans : Console Firebase → Firestore Database → Règles → Publier.
//
// Principe : l'identité d'une personne est la partie avant le "@" de son identifiant
// (en interne, l'identifiant "elodie" correspond à elodie@example.com). Seuls les membres de la famille (présents dans
// la collection "membres") ont accès à quoi que ce soit, et le serveur refuse de
// renvoyer à quelqu'un tout cadeau dont il est le destinataire.

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚙️ Identifiant de l'organisateur (identique à ORGANISATEUR dans config.js).
    // C'est la seule personne qui peut "s'inscrire" toute seule dans la famille,
    // à sa première connexion. Ensuite, ce sont les membres qui ajoutent les autres.
    function organisateur() {
      return 'romain';
    }

    function moi() {
      return request.auth.token.email.split('@')[0];
    }
    function connecte() {
      return request.auth != null && request.auth.token.email is string;
    }
    // Membre de la famille AVEC accès : les enfants (enfant == true) n'ont jamais accès,
    // même si quelqu'un créait un compte avec leur identifiant.
    function estMembre() {
      return connecte()
        && get(/databases/$(database)/documents/membres/$(moi())).data.get('enfant', false) == false;
    }

    // ----- Membres de la famille -----
    function membreValide(d) {
      return d.keys().hasOnly(['nom', 'enfant'])
        && d.nom is string && d.nom.size() > 0 && d.nom.size() <= 40
        && d.get('enfant', false) is bool;
    }
    match /membres/{membreId} {
      allow read: if estMembre();
      allow create: if membreId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && membreValide(request.resource.data)
        && (estMembre() || (connecte() && membreId == moi() && moi() == organisateur()
                            && request.resource.data.get('enfant', false) == false));
      // On ne peut pas passer en "enfant" (sans accès) ni soi-même ni l'organisateur.
      allow update: if estMembre() && membreValide(request.resource.data)
        && (request.resource.data.get('enfant', false) == false
            || (membreId != moi() && membreId != organisateur()));
      // Retirer quelqu'un lui coupe l'accès. On ne peut pas se retirer soi-même.
      allow delete: if estMembre() && membreId != moi();
    }

    // ----- Envies : ce que chacun aimerait recevoir (visible par toute la famille) -----
    function texteValide(d) {
      return d.titre is string && d.titre.size() > 0 && d.titre.size() <= 120
        && d.get('lien', '') is string && d.get('lien', '').size() <= 500
        && d.get('note', '') is string && d.get('note', '').size() <= 200;
    }
    function envieValide(d) {
      return d.keys().hasOnly(['pour', 'par', 'titre', 'lien', 'note', 'cree'])
        && d.par == moi() && d.pour == moi()
        && texteValide(d);
    }
    match /envies/{envieId} {
      allow read: if estMembre();
      allow create: if estMembre() && envieValide(request.resource.data)
        && request.resource.data.cree == request.time;
      allow update: if estMembre() && resource.data.par == moi()
        && envieValide(request.resource.data)
        && request.resource.data.cree == resource.data.cree;
      allow delete: if estMembre() && resource.data.par == moi();
    }

    // ----- Cadeaux : idées et achats pour quelqu'un (jamais visibles par le destinataire) -----
    // par       = qui l'a noté
    // achetePar = qui l'a acheté (null tant que c'est une idée)
    // envie     = l'envie de la liste du destinataire qu'il couvre, s'il y en a une
    function acheteur(d) {
      return d.get('achetePar', null);
    }
    function cadeauValide(d) {
      return d.keys().hasOnly(['pour', 'par', 'titre', 'lien', 'note', 'cree', 'achetePar', 'envie',
                               'statut', 'prix'])   // statut et prix : anciennes fiches
        && d.pour is string && d.pour != moi()
        && exists(/databases/$(database)/documents/membres/$(d.pour))
        && texteValide(d)
        && (acheteur(d) == null || acheteur(d) is string)
        && (d.get('envie', null) == null || d.get('envie', null) is string);
    }
    // On ne peut que s'attribuer un achat libre, ou annuler son propre achat.
    function achatPermis(avant, apres) {
      return acheteur(apres) == acheteur(avant)
        || (acheteur(avant) == null && acheteur(apres) == moi())
        || (acheteur(avant) == moi() && acheteur(apres) == null);
    }
    match /cadeaux/{cadeauId} {
      // La règle clé : jamais de lecture d'un cadeau qui m'est destiné.
      allow read: if estMembre() && resource.data.pour != moi();

      allow create: if estMembre()
        && cadeauValide(request.resource.data)
        && request.resource.data.par == moi()
        && (acheteur(request.resource.data) == null || acheteur(request.resource.data) == moi())
        && request.resource.data.cree == request.time;

      // L'auteur modifie le contenu ; les autres peuvent seulement l'acheter ou annuler leur achat.
      allow update: if estMembre()
        && cadeauValide(request.resource.data)
        && achatPermis(resource.data, request.resource.data)
        && request.resource.data.par == resource.data.par
        && request.resource.data.pour == resource.data.pour
        && request.resource.data.cree == resource.data.cree
        && request.resource.data.get('envie', null) == resource.data.get('envie', null)
        && (resource.data.par == moi()
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['achetePar', 'statut']));

      // L'auteur supprime sa fiche, sauf si quelqu'un d'autre l'a déjà achetée.
      allow delete: if estMembre() && resource.data.pour != moi()
        && resource.data.par == moi()
        && (acheteur(resource.data) == null || acheteur(resource.data) == moi());
    }
  }
}
